# Required — LLM backend (OpenRouter)
OPENROUTER_API_KEY=

# Optional — custom domain / alternate production URL (no trailing slash).
# Used by the API origin allow-list.
NEXT_PUBLIC_APP_URL=

# Optional — enables shareable public brief links (/b/<id>).
# Create a free database at https://upstash.com and paste the REST creds here.
# If unset, the Share button reports "sharing not configured" and the rest of
# the app works normally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
