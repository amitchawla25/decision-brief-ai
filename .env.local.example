# Required — LLM backend (OpenRouter)
OPENROUTER_API_KEY=

# Optional — custom domain / alternate production URL (no trailing slash).
# Used by the API origin allow-list.
NEXT_PUBLIC_APP_URL=

# Optional — enables shareable public brief links (/b/<id>), backed by Supabase.
# From your Supabase project: Settings → API → Project URL and the
# service_role key. The service_role key is a server-only secret — never
# prefix it with NEXT_PUBLIC. If unset, the Share button reports "sharing not
# configured" and the rest of the app works normally.
# Requires a `shared_briefs` table (see src/lib/shareStore.ts for the SQL).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
